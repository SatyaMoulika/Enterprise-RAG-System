# Copy to backend/.env for direct local development. Never commit your real .env.
DATABASE_URL=postgresql+psycopg://rag:replace-with-local-db-password@127.0.0.1:5432/rag
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSION=384
CORS_ORIGINS=["http://localhost:5173"]

# Keep dense as the baseline; compare with hybrid before switching.
RETRIEVAL_STRATEGY=dense
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_CONTEXT_CHARACTERS=24000

# Optional experiment: off by default; dependency/model installation is separate.
RERANKER_MODE=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Experimental bounded salary calculations; evaluate before enabling.
FINANCIAL_CALCULATIONS_ENABLED=false

# Index provenance and worker limits. For Ollama, revision is its /api/tags digest;
# for SentenceTransformers, use a Hugging Face commit revision.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REVISION=
INGESTION_MEMORY_MB=4096
INGESTION_TIMEOUT_SECONDS=900

# Similarity is cosine, not a probability. Calibrate on held-out source cases.
# 0.3 passed the all-minilm development regression; validate on your own corpus.
RETRIEVAL_MIN_SIMILARITY=0.3
RETRIEVAL_NEIGHBORS=1
RETRIEVAL_MAX_DOCUMENT_CHUNKS=3
GENERATION_CONTEXT_TOKENS=16384
GENERATION_MAX_TOKENS=1024

# Use low-randomness grounded answers; citation repair always uses zero.
GENERATION_TEMPERATURE=0.0

# Local-only shortcut: reset with email and new password, without mailbox verification.
# Never enable this on an externally accessible deployment.
LOCAL_DIRECT_PASSWORD_RESET=true
# Email recovery is used when the local shortcut is disabled.
PUBLIC_APP_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
