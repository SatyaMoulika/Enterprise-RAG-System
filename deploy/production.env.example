# Keep the real production environment outside Git; chmod 600 the file.
# Use independent generated secrets. Never copy local example passwords.
RAG_DB_PASSWORD=replace-with-an-independent-random-secret
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
PUBLIC_DOMAIN=knowledge.example.com
ACME_EMAIL=ops@example.com
CADDY_IMAGE=caddy:2-alpine
RETRIEVAL_MIN_SIMILARITY=0.3
GENERATION_TEMPERATURE=0.0
FINANCIAL_CALCULATIONS_ENABLED=false
# Set to your Ollama all-minilm digest when model revision pinning is enabled.
EMBEDDING_REVISION=

# Password recovery email: use your verified sender/provider credentials.
LOCAL_DIRECT_PASSWORD_RESET=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
