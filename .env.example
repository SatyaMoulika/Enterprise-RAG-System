# Docker Compose reads this file after you copy it to .env.
# Generate two independent random values; do not use these placeholders.
RAG_DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Keep dense as the baseline; compare with hybrid before switching.
RETRIEVAL_STRATEGY=dense
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_CONTEXT_CHARACTERS=24000

# Optional experiment: off by default; dependency/model installation is separate.
RERANKER_MODE=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_INSTALL_RERANKING=false
