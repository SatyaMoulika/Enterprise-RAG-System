# Copy to backend/.env for direct local development. Never commit your real .env.
DATABASE_URL=postgresql+psycopg://rag:replace-with-local-db-password@127.0.0.1:5432/rag
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSION=384
CORS_ORIGINS=["http://localhost:5173"]

# Keep dense as the baseline; compare with hybrid before switching.
RETRIEVAL_STRATEGY=dense
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_CONTEXT_CHARACTERS=24000

# Optional experiment: off by default; dependency/model installation is separate.
RERANKER_MODE=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
